# Optional override for the backend API base URL. Leave commented out to
# use same-origin relative "/api/..." calls, proxied to the local FastAPI
# backend by Vite's dev server (see vite.config.ts's server.proxy). Only
# needed if the backend isn't reachable at http://127.0.0.1:8000.
# VITE_SLOPANOC_API_BASE_URL=http://127.0.0.1:8000

# NEVER add secrets here (Power Automate URLs, GCP service-account
# credentials, Secret Manager values, database credentials, API keys,
# etc.). Every VITE_* variable is inlined verbatim into the client bundle
# and is publicly visible to anyone who loads the page.

# Local Resources console defaults to same-origin /api/observability/*.
# Vite routes those reads to the separate reader at 127.0.0.1:8001;
# POST SSE receipts and business APIs continue to use ANOC at 127.0.0.1:8000.
# Keep this unset for the first-party local topology.
# VITE_OBSERVABILITY_API_BASE_URL=http://127.0.0.1:8001
# Production requires an explicit separately provisioned HTTPS read-plane URL.
# Routing does not provide authentication: a real shared verified identity adapter
# is required. ANOC's development-user header is not a verified session.

# Server-side human identity (never VITE_*). Set in BOTH backend shells only.
# Defaults to disabled. Explicit local/development grants require a reviewed file.
# SLOPANOC_AUTH_MODE=development
# SLOPANOC_OTEL_ENVIRONMENT=development
# SLOPANOC_DEV_AUTH_POLICY_FILE=/absolute/path/to/reviewed/development-auth.json
# Example: config/auth/development.example.json (Operator metadata only).
# Production rejects development mode. "iap" is currently an inert deny-only seam.

# Phase-1 hybrid audit: disabled by default; workers are separate processes.
SLOPANOC_HYBRID_AUDIT_ENABLED=false
SLOPANOC_HYBRID_PUBLISHER_ENABLED=false
SLOPANOC_HYBRID_PROJECTOR_ENABLED=false
SLOPANOC_HYBRID_ENVIRONMENT=development
# Worker-only DB URL comes from secure deployment configuration.
# SLOPANOC_HYBRID_DATABASE_URL=
# SLOPANOC_HYBRID_PROJECT=pr-msn-dev-gl-slopai-01
# SLOPANOC_HYBRID_AUDIT_TOPIC=projects/pr-msn-dev-gl-slopai-01/topics/slopanoc-development-audit-events-v1
# SLOPANOC_HYBRID_PUSH_AUDIENCE=https://<verified-projector-service-host>
# SLOPANOC_HYBRID_PUSH_SERVICE_ACCOUNT=slopanoc-development-push@pr-msn-dev-gl-slopai-01.iam.gserviceaccount.com

# Execution audit journal / controlled Teams egress: explicit opt-in AFTER approved
# schema/grants and compatibility validation. Never activates Pub/Sub or cloud DDL.
SLOPANOC_HYBRID_EXECUTION_JOURNAL_ENABLED=false
SLOPANOC_HYBRID_CONTROLLED_EGRESS_ENABLED=false
