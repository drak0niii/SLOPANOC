# =====================================================================
# SLOPANOC frontend (Vite) example configuration.
#
# Copy to `.env.local` and fill in the placeholders for your deployment.
#
# EVERY `VITE_*` VALUE IS INLINED VERBATIM INTO THE CLIENT BUNDLE AND IS
# PUBLICLY VISIBLE to anyone who loads the page. Nothing here is secret
# and nothing secret may be added here -- no client secret, no Power
# Automate URL, no GCP credential, no Secret Manager value, no database
# credential, no API key. A browser cannot keep a secret.
# =====================================================================

# --- Backend location -------------------------------------------------
# Optional. Leave commented out to use same-origin relative "/api/..."
# calls, proxied to the local FastAPI backend by Vite's dev server (see
# vite.config.ts's server.proxy). Only needed if the backend isn't
# reachable at http://127.0.0.1:8000.
# VITE_SLOPANOC_API_BASE_URL=http://127.0.0.1:8000

# --- Authentication mode ----------------------------------------------
# `development` (default) or `oidc`. MUST match the backend's
# SLOPANOC_AUTH_MODE: the frontend deciding it is in development mode
# while the backend requires a token produces an app that renders and
# then fails every request.
VITE_SLOPANOC_AUTH_MODE=development

# --- Development mode only --------------------------------------------
# The identity claimed by the unverified `X-SLOPANOC-DEV-USER` header.
# This is NOT authentication -- anyone reaching the API can claim any id.
# Ignored entirely when VITE_SLOPANOC_AUTH_MODE=oidc.
VITE_SLOPANOC_DEV_USER=dev-user

# --- OIDC mode only ---------------------------------------------------
# Authority/issuer URL. Must be the SAME issuer the backend validates
# against (SLOPANOC_AUTH_ISSUER).
#   Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
# VITE_SLOPANOC_AUTH_ISSUER=https://login.microsoftonline.com/REPLACE-TENANT-ID/v2.0

# Public client id of the SPA app registration. A PUBLIC client: there is
# no client secret in this flow, and one must never be added here.
# VITE_SLOPANOC_AUTH_CLIENT_ID=REPLACE-SPA-CLIENT-ID

# Scopes requested at sign-in.
#
# THIS MUST INCLUDE THE API'S OWN SCOPE, or the authorization server
# issues only an ID token and the app has no credential this API will
# accept. The API scope's resource must match the backend's configured
# SLOPANOC_AUTH_AUDIENCE.
#   Entra ID: "openid profile api://<api-client-id>/user_impersonation"
# VITE_SLOPANOC_AUTH_SCOPE=openid profile api://REPLACE-API-CLIENT-ID/user_impersonation

# --- Redirect URI (not configured here -- registered with the IdP) -----
# The app derives its redirect URI as <origin>/auth/callback and this is
# not configurable, so it cannot drift from the route that handles it.
# REGISTER EXACTLY THIS VALUE as a redirect URI of type "SPA" on the app
# registration, for every origin you serve from:
#   http://localhost:5173/auth/callback      (Vite dev server)
#   https://<your-host>/auth/callback        (deployed)
# Post-logout redirect URI is the bare origin (e.g. http://localhost:5173).
