# =====================================================================
# SLOPANOC backend example configuration (POST-6A).
#
# THIS FILE CONTAINS PLACEHOLDERS ONLY. Never commit a real value for
# anything here: no gateway URL, no database credential, no client
# secret, no token. In a deployment these come from the environment or
# GCP Secret Manager (`*_SECRET_RESOURCE` variants), never from a file in
# the repository.
#
# Only the authentication and governance settings are documented in full
# here -- the complete variable table lives in README.md.
# =====================================================================

# ---------------------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------------------

# `development` (default) or `oidc`.
#
# development: identity comes from the UNVERIFIED `X-SLOPANOC-DEV-USER`
#   header. Anyone who can reach the API can claim to be any user. This
#   is for local work only and must never be used where the API is
#   reachable by anyone else.
#
# oidc: a verified bearer token is REQUIRED on every request and the dev
#   header is ignored completely, including when sent alongside a valid
#   token. If issuer/audience/JWKS are not all configured, every request
#   is REJECTED -- it never degrades to development identity, because a
#   deployment that asks for verified identity and cannot do it must fail
#   closed.
#
# MUST match the frontend's VITE_SLOPANOC_AUTH_MODE.
SLOPANOC_AUTH_MODE=development

# --- Required when SLOPANOC_AUTH_MODE=oidc ---------------------------

# Expected `iss`. Must equal the frontend's VITE_SLOPANOC_AUTH_ISSUER.
#   Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
# SLOPANOC_AUTH_ISSUER=https://login.microsoftonline.com/REPLACE-TENANT-ID/v2.0

# Expected `aud` -- THIS API's own identifier, not the SPA's client id.
# The frontend must request a scope belonging to this resource, or it
# receives a token audienced to something else and every request is
# rejected.
#   Entra ID: api://<api-client-id>   (or the API app's client id)
# SLOPANOC_AUTH_AUDIENCE=api://REPLACE-API-CLIENT-ID

# JWKS endpoint for signature verification. CONFIGURED, never read from
# the token: a token that names its own key source verifies itself.
#   Entra ID: https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# SLOPANOC_AUTH_JWKS_URL=https://login.microsoftonline.com/REPLACE-TENANT-ID/discovery/v2.0/keys

# --- Optional when SLOPANOC_AUTH_MODE=oidc ---------------------------

# Signature algorithm ALLOWLIST (comma-separated). Default RS256.
# Never widen this to include `none` or an HMAC algorithm alongside an
# asymmetric one -- that is the classic algorithm-confusion attack.
# SLOPANOC_AUTH_ALGORITHMS=RS256

# Comma-separated tenant ids (`tid`) permitted to sign in. Empty means
# the issuer's own check is the only tenant boundary, which is correct
# for a single-tenant issuer and NOT sufficient for a multi-tenant one.
# SLOPANOC_AUTH_ALLOWED_TENANTS=REPLACE-TENANT-ID

# Token claim carrying role values. Default `roles` (Entra ID app roles).
# SLOPANOC_AUTH_ROLES_CLAIM=roles

# ---------------------------------------------------------------------
# GOVERNANCE AUTHORIZATION
# Who may author / approve / revoke a governed operation descriptor.
# Deny-by-default: with none of these set, nobody can approve anything.
# ---------------------------------------------------------------------

# Role values (from the VERIFIED token's roles claim) that grant governor
# authority. This is the production path: authorization earned from a
# verified identity, not from a deployment declaring itself trusted.
# SLOPANOC_KNOWLEDGE_GOVERNOR_ROLES=SLOPANOC.Governor

# Explicit allowlist of user ids that may approve. Derived identity form
# is `aad:<tid>:<oid>` for Entra ID, or `oidc:<iss>:<sub>` otherwise --
# never a display name or bare email.
# SLOPANOC_KNOWLEDGE_GOVERNORS=aad:REPLACE-TENANT-ID:REPLACE-OBJECT-ID

# DEVELOPMENT ONLY. Permits governance mutations while identity is the
# unverified dev header. Leave UNSET in any shared or deployed
# environment: enabling it means anyone who can reach the API can claim a
# governor's identity by setting a header.
# SLOPANOC_GOVERNANCE_DEV_MODE=true

# DEVELOPMENT ONLY. The identity a host-run administrative tool acts as
# when talking to the local database directly. This is CONFIGURATION,
# NOT AUTHENTICATED IDENTITY -- it proves only that someone could set an
# environment variable on this host. The descriptor CLI's normal path
# calls the authenticated API with a real token instead; this exists only
# for local development against a local database.
# SLOPANOC_ADMIN_ACTOR_ID=dev-governor

# ---------------------------------------------------------------------
# DESCRIPTOR CLI (backend/tools/admin/descriptor_admin.py)
# The normal, authenticated path. Not read by the server.
# ---------------------------------------------------------------------

# Base URL of the running SLOPANOC API the CLI calls.
# SLOPANOC_API_BASE_URL=https://REPLACE-YOUR-HOST

# The CLI reads its bearer token from the SLOPANOC_API_TOKEN environment
# variable at run time. DO NOT put a token in this file or any other
# file: obtain one per session and export it into the shell only. The
# token identifies the human governor, and the approval record is written
# against the identity the API verified from it -- not against anything
# the CLI claimed.
# SLOPANOC_API_TOKEN=<exported per session, never stored>
